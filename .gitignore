# Terraform local files and state
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json
!*.example.tfvars

# Local secrets and environment configuration
.env
.env.*
!.env.docker.example
!.env.example

# Editor and operating system files
.idea/
.vscode/
.DS_Store

# Hologram generated JavaScript bundles.
/priv/static/hologram/

# Phoenix / Mix compiled artifacts and dependencies.
/_build/
/cover/
/deps/
/doc/
/.fetch
erl_crash.dump
*.ez
/tmp/

# Generated application assets and caches.
/priv/static/assets/
/priv/static/cache_manifest.json

# Node.js / npm files.
npm-debug.log
/assets/node_modules/

# Local direnv configuration; may load local secrets.
.envrc
